#!/usr/bin/env python3
"""Build a Salon catalog: the paintings the widget picks from.

  bin/build-catalog                         the built-in catalog (catalog.json)
  bin/build-catalog --artists "francis-bacon, Philip Guston" --out PATH

Artists are WikiArt names or slugs ("Francis Bacon" and "francis-bacon" are
the same). An artist WikiArt does not have, or whose images it withholds, is
looked up on Wikipedia and Wikimedia Commons instead.

The widget never queries an API while you look at paintings; it only loads
images. Everything else it shows (title, year, medium, collection, notes)
comes from the catalog this script writes. Every image link is checked here
and the broken ones left out.

Sources: WikiArt's app endpoints (unofficial), Wikipedia's REST summaries, and
Wikimedia Commons. Raw answers are cached (--cache, default
$XDG_CACHE_HOME/salon/http) so a rerun resumes and a rebuild is quick.

Progress goes to stdout as lines the widget reads:
  progress <done> <total> <artist name>
  done <paintings> <path>
Problems go to stderr; the exit status is 0 when a catalog was written.
"""

import argparse
import concurrent.futures
import html
import json
import os
import random
import re
import sys
import time
import unicodedata
import urllib.error
import urllib.parse
import urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
UA = "salon-omarchy-widget/0.3 (https://github.com/merthurturk/salon)"

# The built-in catalog: masters whose work is out of copyright, so a fresh
# install shows something at once with nothing to clear.
DEFAULT_ARTISTS = ["francisco-goya", "hieronymus-bosch", "pieter-bruegel-the-elder",
                   "rembrandt", "william-turner", "vincent-van-gogh"]

MAX_ARTISTS = 40
SKIP_GENRES = {"sketch and study", "design", "illustration", "poster", "caricature"}
SKIP_TECHNIQUES = ("etching", "aquatint", "lithograph", "drypoint", "engraving",
                   "woodcut", "print", "chalk", "pencil", "charcoal", "ink", "pen")
PLACEHOLDER = "FRAME-600x480"
MAX_EXTRACT = 700
MAX_FIELD = 160

CACHE = ""
_images = None


def log(message):
    print(message, file=sys.stderr, flush=True)


def fetch(url, cache_name, refresh=False, attempts=3):
    path = os.path.join(CACHE, cache_name)
    if not refresh and os.path.exists(path):
        try:
            with open(path, encoding="utf-8") as f:
                return json.load(f)
        except ValueError:
            pass
    last = None
    for attempt in range(attempts):
        try:
            req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "application/json"})
            with urllib.request.urlopen(req, timeout=20) as r:
                data = json.loads(r.read(4_000_000).decode("utf-8"))
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path + ".tmp", "w", encoding="utf-8") as f:
                json.dump(data, f)
            os.replace(path + ".tmp", path)
            return data
        except urllib.error.HTTPError as e:
            last = e
            if e.code == 404:
                break
            time.sleep(2 * (attempt + 1))
        except Exception as e:  # noqa: BLE001 - every failure is retried, then reported
            last = e
            time.sleep(1.5 * (attempt + 1))
    log(f"  ! {url}: {last}")
    return None


def image_ok(url, refresh=False):
    """Does the image load? Checked once per link; the answers are cached."""
    global _images
    path = os.path.join(CACHE, "images.json")
    if _images is None:
        try:
            _images = {} if refresh else json.load(open(path, encoding="utf-8"))
        except (OSError, ValueError):
            _images = {}
    if url not in _images:
        status = 0
        for attempt in range(3):
            try:
                req = urllib.request.Request(url, method="HEAD", headers={"User-Agent": UA})
                with urllib.request.urlopen(req, timeout=20) as r:
                    status = r.status if r.headers.get("Content-Type", "").startswith("image/") else 415
                break
            except urllib.error.HTTPError as e:
                status = e.code
                if e.code not in (429, 500, 502, 503, 504):
                    break
                time.sleep(2 * (attempt + 1))
            except Exception:  # noqa: BLE001 - network trouble is retried, then counted as a failure
                time.sleep(2 * (attempt + 1))
        _images[url] = status
        os.makedirs(CACHE, exist_ok=True)
        with open(path + ".tmp", "w", encoding="utf-8") as f:
            json.dump(_images, f)
        os.replace(path + ".tmp", path)
    return _images[url] == 200


def clean(value, limit=MAX_FIELD):
    if value is None:
        return ""
    text = html.unescape(re.sub(r"<[^>]+>", "", str(value)))
    text = re.sub(r"\s+", " ", text.replace("\xa0", " ")).strip()
    return text[:limit]


def norm(title):
    t = unicodedata.normalize("NFKD", title).encode("ascii", "ignore").decode().lower()
    t = re.sub(r"\(.*?\)", "", t)
    t = re.sub(r"^(the|a|an|la|le|el|les) ", "", t.strip())
    return re.sub(r"[^a-z0-9]+", " ", t).strip()


def slugify(name):
    s = unicodedata.normalize("NFKD", name).encode("ascii", "ignore").decode().lower().strip()
    return re.sub(r"[^a-z0-9]+", "-", s).strip("-")[:60]


def first_sentences(text, n=2):
    parts = re.split(r"(?<=[.!?])\s+(?=[A-Z])", text)
    return " ".join(parts[:n])


def safe_name(s):
    return re.sub(r"[^A-Za-z0-9_.-]", "_", s)[:150]


# ---- Wikipedia and Commons.

def wiki_summary(title, refresh=False):
    slug = title.replace(" ", "_")
    url = "https://en.wikipedia.org/api/rest_v1/page/summary/" + urllib.parse.quote(slug, safe="")
    data = fetch(url, "wiki/" + safe_name(slug) + ".json", refresh)
    if not data or data.get("type") != "standard":
        return None
    extract = clean(data.get("extract"), 4000)
    if len(extract) > MAX_EXTRACT:
        cut = extract[:MAX_EXTRACT]
        extract = cut[:cut.rfind(". ") + 1] if ". " in cut else cut.rstrip() + "…"
    image = data.get("originalimage") or data.get("thumbnail") or {}
    return {
        "title": clean(data.get("title")),
        "extract": extract,
        "url": (data.get("content_urls") or {}).get("desktop", {}).get("page", ""),
        "description": clean(data.get("description")),
        "image": image,
    }


def wiki_category(category, refresh=False):
    url = ("https://en.wikipedia.org/w/api.php?action=query&list=categorymembers&cmtype=page"
           "&cmlimit=500&format=json&cmtitle=Category:" + urllib.parse.quote(category))
    data = fetch(url, "wikicat/" + safe_name(category) + ".json", refresh) or {}
    return [m["title"] for m in data.get("query", {}).get("categorymembers", [])
            if not m["title"].startswith("List of")]


def wiki_search(query, refresh=False):
    url = ("https://en.wikipedia.org/w/api.php?action=query&list=search&srnamespace=0&srlimit=50"
           "&format=json&srsearch=" + urllib.parse.quote(query))
    data = fetch(url, "wikisearch/" + safe_name(query) + ".json", refresh) or {}
    return [m["title"] for m in data.get("query", {}).get("search", [])]


def sized(source, width, height):
    """Commons originals can run to tens of megabytes; ask for the 1280px
    rendition instead. Fair-use files on en.wikipedia are small already."""
    m = re.match(r"https://upload\.wikimedia\.org/wikipedia/commons/(\w/\w\w)/([^/]+)$", source)
    if m and width > 1280:
        return (f"https://upload.wikimedia.org/wikipedia/commons/thumb/{m.group(1)}/{m.group(2)}/1280px-{m.group(2)}",
                1280, round(height * 1280 / width))
    return source, width, height


def year_in(*texts):
    m = re.search(r"\b(1[2-9]\d\d|20\d\d)\b", " ".join(texts))
    return m.group(1) if m else ""


def wiki_painting(title, artist, refresh=False):
    """A painting from a Wikipedia article alone, for works WikiArt lacks."""
    s = wiki_summary(title, refresh)
    if not s:
        return None
    surname = artist["name"].split()[-1].lower()
    if "painting" not in s["description"].lower() or surname not in s["description"].lower():
        return None
    source = str(s["image"].get("source", "")).split("?")[0]
    if not source.startswith("https://upload.wikimedia.org/"):
        return None
    source, width, height = sized(source, int(s["image"].get("width") or 0), int(s["image"].get("height") or 0))
    return blank(artist, re.sub(r"\s*\(.*?\)$", "", s["title"]),
                 year_in(s["description"], title, first_sentences(s["extract"], 1)),
                 source, width, height, s["url"], wiki={"extract": s["extract"], "url": s["url"]})


def commons_paintings(artist, refresh=False):
    """Freely licensed photographs of the artist's paintings on Commons."""
    query = f'"{artist["name"]}" painting'
    url = ("https://commons.wikimedia.org/w/api.php?action=query&generator=search&gsrnamespace=6"
           "&gsrlimit=30&prop=imageinfo&iiprop=url|size|mime|extmetadata&iiurlwidth=1280&format=json"
           "&gsrsearch=" + urllib.parse.quote(query))
    data = fetch(url, "commons/" + safe_name(artist["slug"]) + ".json", refresh) or {}
    name = artist["name"].lower()
    out = []
    for page in (data.get("query", {}).get("pages") or {}).values():
        info = (page.get("imageinfo") or [None])[0]
        if not info or info.get("mime") not in ("image/jpeg", "image/png"):
            continue
        meta = info.get("extmetadata") or {}
        description = clean(meta.get("ImageDescription", {}).get("value"), 400)
        filename = page["title"][5:]
        if name not in (description + " " + filename).lower():
            continue
        if "fair use" in clean(meta.get("LicenseShortName", {}).get("value")).lower():
            continue
        # Commons search also finds photographs of the artist, exhibition
        # views, prints, and images made "in the style of" them.
        haystack = (description + " " + filename).lower()
        if any(word in haystack for word in NOT_PAINTINGS):
            continue
        title = title_from_filename(clean(meta.get("ObjectName", {}).get("value")) or filename, artist["name"])
        if not title:
            continue
        image = (info.get("thumburl") or info.get("url") or "").split("?")[0]
        out.append(blank(artist, title, year_in(filename, description, clean(meta.get("DateTimeOriginal", {}).get("value"))),
                         image, int(info.get("thumbwidth") or info.get("width") or 0),
                         int(info.get("thumbheight") or info.get("height") or 0), info.get("descriptionurl", ""),
                         medium="oil on canvas" if "oil on canvas" in (description + filename).lower() else ""))
    return out


NOT_PAINTINGS = ("dall", "ai-generated", "ai generated", "midjourney", "stable diffusion", "in style of",
                 "in the style of", "photograph", "poseert", "bestanddeel", "tentoonstelling", "exhibition",
                 "litho", "print", "poster", "portrait of the artist", "masterpiece", "museum of modern art",
                 "installation view", "gallery view")


def title_from_filename(filename, name):
    t = re.sub(r"\.[a-z]+$", "", filename, flags=re.I)
    t = re.sub(re.escape(name), "", t, flags=re.I)
    t = re.sub(r"\b(1[2-9]\d\d|20\d\d)\b|oil on canvas|painting|-\d+$", "", t, flags=re.I)
    t = re.sub(r"^[\s,.\-_]+|[\s,.\-_]+$", "", re.sub(r"[_.]+", " ", t))
    t = re.sub(r"\s*,\s*", ", ", t).strip(", ")
    return t[:1].upper() + t[1:] if len(t) > 2 else ""


# ---- WikiArt.

def is_painting(d):
    genre = (d.get("genre") or "").lower()
    if genre in SKIP_GENRES:
        return False
    material = " ".join(filter(None, [d.get("material"), d.get("technique")])).lower()
    tags = (d.get("tags") or "").lower()
    if "sketch" in tags and "oil" not in material:
        return False
    if material and not any(m in material for m in ("oil", "acrylic", "tempera", "canvas", "panel", "board")) \
            and any(t in material for t in SKIP_TECHNIQUES):
        return False
    image = d.get("image") or ""
    return image.startswith("https://") and PLACEHOLDER not in image


def blank(artist, title, year, image, width, height, source, wiki=None, medium=""):
    p = {"artist": artist["slug"], "title": clean(title), "year": year, "image": image,
         "width": width, "height": height, "style": "", "genre": "", "medium": medium, "size": "",
         "collection": "", "series": "", "description": "", "source": source}
    if wiki:
        p["wiki"] = wiki
    return p


def wikiart_paintings(artist, listing, preferred, cap, refresh):
    # Large œuvres are sampled, the same way on every build, keeping first
    # the works that have a Wikipedia article.
    rng = random.Random(artist["slug"])
    first = [p for p in listing if norm(p.get("title", "")) in preferred]
    rest = [p for p in listing if norm(p.get("title", "")) not in preferred]
    rng.shuffle(rest)
    chosen = (first + rest)[: int(cap * 1.4)]  # room for the ones the filters drop

    def detail(p):
        cid = p["contentId"]
        return fetch(f"https://www.wikiart.org/en/App/Painting/ImageJson/{cid}",
                     f"wikiart/{artist['slug']}/{cid}.json", refresh)

    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
        details = list(pool.map(detail, chosen))
    out = []
    for d in details:
        if not d or not is_painting(d):
            continue
        size = f"{d['sizeX']:g} × {d['sizeY']:g} cm" if d.get("sizeX") and d.get("sizeY") else ""
        p = blank(artist, d.get("title"), clean(d.get("yearAsString"), 20), d["image"],
                  int(d.get("width") or 0), int(d.get("height") or 0),
                  f"https://www.wikiart.org/en/{d.get('artistUrl', artist['slug'])}/{d.get('url', '')}",
                  medium=", ".join(filter(None, [clean(d.get("material")), clean(d.get("technique"))])))
        p.update(style=clean(d.get("style")), genre=clean(d.get("genre")), size=size,
                 collection=clean(d.get("galleryName")), series=clean(d.get("serie")),
                 description=clean(d.get("description"), MAX_EXTRACT))
        out.append(p)
    return out


def resolve(token, refresh):
    """An artist as typed ("Francis Bacon", "francis-bacon") to what WikiArt
    and Wikipedia call them."""
    slug = slugify(token)
    if not slug:
        return None
    data = fetch(f"https://www.wikiart.org/en/{slug}?json=2", f"wikiart-artist/{slug}.json", refresh) or {}
    name = clean(data.get("artistName")) if isinstance(data, dict) else ""
    wiki_url = str(data.get("wikipediaUrl") or "") if isinstance(data, dict) else ""
    wiki_title = urllib.parse.unquote(wiki_url.rsplit("/wiki/", 1)[1]).replace("_", " ") if "/wiki/" in wiki_url else ""
    if not name:
        # Not on WikiArt: take the name as typed, or rebuild it from the slug.
        name = token.strip() if " " in token.strip() else " ".join(w.capitalize() for w in slug.split("-"))
    return {"slug": slug, "name": name, "onWikiart": bool(data.get("artistName")) if isinstance(data, dict) else False,
            "wiki": wiki_title or name}


def build_artist(artist, cap, refresh):
    summary = wiki_summary(artist["wiki"], refresh) or {}
    about = first_sentences(summary.get("extract", ""), 2)

    articles = {}
    for title in wiki_category(f"Paintings_by_{artist['name'].replace(' ', '_')}", refresh):
        articles.setdefault(norm(title), title)
    for title in wiki_search(f'"{artist["name"]}" painting', refresh):
        articles.setdefault(norm(title), title)
    articles.pop(norm(artist["name"]), None)

    paintings = []
    if artist["onWikiart"]:
        listing = fetch(f"https://www.wikiart.org/en/App/Painting/PaintingsByArtist?artistUrl={artist['slug']}&json=2",
                        f"wikiart/{artist['slug']}.json", refresh) or []
        paintings = wikiart_paintings(artist, listing, set(articles), cap, refresh)

    surname = artist["name"].split()[-1].lower()
    matched = set()
    for p in paintings:
        title = articles.get(norm(p["title"]))
        s = wiki_summary(title, refresh) if title else None
        if s and surname in (s["extract"] + s["description"]).lower():
            p["wiki"] = {"extract": s["extract"], "url": s["url"]}
            matched.add(title)
    for title in articles.values():
        if title not in matched:
            extra = wiki_painting(title, artist, refresh)
            if extra:
                paintings.append(extra)
    # Commons is noisy, so only when there is next to nothing else (living
    # artists WikiArt does not carry).
    if len(paintings) < 5:
        paintings.extend(commons_paintings(artist, refresh))

    # WikiArt sometimes lacks the "!Large" rendition but still has the
    # original; fall back to it before giving up on a painting.
    seen, kept = set(), []
    for p in paintings:
        key = (norm(p["title"]), p["year"])
        if key in seen or not p["title"]:
            continue
        if not image_ok(p["image"], refresh) and p["image"].endswith("!Large.jpg"):
            p["image"] = p["image"][:-len("!Large.jpg")]
        if image_ok(p["image"], refresh):
            seen.add(key)
            kept.append(p)
    kept = kept[:cap]
    return {"name": artist["name"], "about": about, "url": summary.get("url", "")}, kept


def main():
    global CACHE
    parser = argparse.ArgumentParser(description="Build a Salon catalog.")
    parser.add_argument("--artists", help="comma-separated WikiArt names or slugs (default: the built-in set)")
    parser.add_argument("--out", default=os.path.join(ROOT, "catalog.json"))
    parser.add_argument("--cache", default=os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "salon", "http"))
    parser.add_argument("--max-per-artist", type=int, default=200)
    parser.add_argument("--refresh", action="store_true", help="ignore cached answers")
    args = parser.parse_args()
    CACHE = args.cache
    cap = max(10, min(2000, args.max_per_artist))

    tokens = [t for t in (args.artists.split(",") if args.artists else DEFAULT_ARTISTS) if t.strip()][:MAX_ARTISTS]
    catalog = {"version": 2, "built": time.strftime("%Y-%m-%d"), "artists": {}, "paintings": []}
    for i, token in enumerate(tokens):
        artist = resolve(token, args.refresh)
        print(f"progress {i} {len(tokens)} {artist['name'] if artist else token.strip()}", flush=True)
        if not artist or artist["slug"] in catalog["artists"]:
            continue
        info, paintings = build_artist(artist, cap, args.refresh)
        if not paintings:
            log(f"{artist['name']}: no paintings found")
            continue
        log(f"{artist['name']}: {len(paintings)} paintings, {sum(1 for p in paintings if 'wiki' in p)} with a Wikipedia article")
        catalog["artists"][artist["slug"]] = info
        catalog["paintings"].extend(paintings)

    if not catalog["paintings"]:
        log("No paintings found for any of those artists.")
        return 1

    # A key that survives rebuilds, unlike the position in the list:
    # favourites and their Context Engine notes are filed under it.
    keys = set()
    for p in catalog["paintings"]:
        base = "-".join(filter(None, [p["artist"], norm(p["title"]).replace(" ", "-")[:60].strip("-"), p["year"][:4] or "nd"]))
        key, n = base, 2
        while key in keys:
            key, n = f"{base}-{n}", n + 1
        keys.add(key)
        p["key"] = key

    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
    tmp = args.out + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(catalog, f, ensure_ascii=False, indent=1)
        f.write("\n")
    os.replace(tmp, args.out)
    print(f"progress {len(tokens)} {len(tokens)} ", flush=True)
    print(f"done {len(catalog['paintings'])} {args.out}", flush=True)
    return 0



if __name__ == "__main__":
    sys.exit(main())
